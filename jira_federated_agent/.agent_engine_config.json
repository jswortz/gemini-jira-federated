{
  "display_name": "jira_federated_agent",
  "description": "Grounded Jira Assistant powered by the Gemini Enterprise Jira Federated Data Connector with per-user 3LO access control",
  "identity_type": "AGENT_IDENTITY",
  "env_vars": {
    "DISCOVERY_ENGINE_PROJECT_ID": "${PROJECT_ID}",
    "DISCOVERY_ENGINE_PROJECT_NUMBER": "${PROJECT_NUMBER}",
    "DISCOVERY_ENGINE_LOCATION": "global",
    "DISCOVERY_ENGINE_ID": "grocery-workshop-engine",
    "JIRA_CONNECTOR_COLLECTION_ID": "${JIRA_CONNECTOR_COLLECTION_ID}",
    "JIRA_INSTANCE_URI": "${JIRA_INSTANCE_URI}",
    "JIRA_OAUTH_CLIENT_ID": "${JIRA_OAUTH_CLIENT_ID}",
    "GEMINI_MODEL": "gemini-2.5-flash"
  }
}
