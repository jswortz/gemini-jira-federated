# Vertex AI / ADK Runtime Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Gemini Enterprise (Discovery Engine) Jira Federated Connector Configuration
DISCOVERY_ENGINE_PROJECT_ID=your-gcp-project-id
DISCOVERY_ENGINE_PROJECT_NUMBER=your-gcp-project-number
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_ID=grocery-workshop-engine
JIRA_CONNECTOR_COLLECTION_ID=your-jira-connector-collection-id
JIRA_INSTANCE_URI=https://your-domain.atlassian.net

# User OAuth Configuration
# Account with authorized 3LO Jira token in Gemini Enterprise userStores
OAUTH_USER_ACCOUNT=user@your-domain.com

# Retrieval Mode:
# - 'mcp' (default): Multi-turn ADK agent loop calling Discovery Engine :invokeConnectorMcp
# - 'stream_assist': Native Gemini Enterprise assistant streaming (:streamAssist) with grounding chunks
JIRA_RETRIEVAL_MODE=mcp

# Optional: Interactive OAuth2 Client in ADK Web (triggers adk_request_credential popup)
# OAUTH_CLIENT_ID=your-google-oauth-client-id
# OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# ADK_INTERACTIVE_OAUTH=false
